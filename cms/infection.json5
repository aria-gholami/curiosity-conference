{
  "source": {
    "directories": [
      "src",
      "packages/*/src"
    ],
    "excludes": [
      "Kernel.php"
    ]
  },
  "timeout": 10,
  "logs": {
    "text": "var/log/infection.log"
  },
  "tmpDir": "var/cache",
  "phpUnit": {
    "customPath": "../testing-tools/phpunit"
  },
  "mutators": {
    "@default": true
  }
}
