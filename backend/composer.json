{
    "name": "curiosity-conference/backend",
    "description": "Backend for Curiosity Conference App",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/domain"
        },
        {
            "type": "path",
            "url": "packages/application"
        },
        {
            "type": "path",
            "url": "packages/adapters"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "curiosity-conference-backend/adapters": "dev-main",
        "curiosity-conference-backend/application": "dev-main",
        "curiosity-conference-backend/domain": "dev-main",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.3",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*",
        "symfony/flex": "^2.10",
        "symfony/http-foundation": "^8.0.8",
        "symfony/uid": "8.0.*"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.67",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "8.0.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CuriosityConference\\Adapters\\Tests\\": "packages/adapters/tests/",
            "CuriosityConference\\Application\\Tests\\": "packages/application/tests/",
            "CuriosityConference\\Domain\\Tests\\": "packages/domain/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}
